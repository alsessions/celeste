            {% if category.plainText | length %}
            <div class="max-w-6xl mx-auto mt-10 px-4 prose">

              <div class="grid md:grid-cols-2 md:gap-10">
                <div>
              {# Category description field #}
                {{ category.plainText | markdown }}
            </div>
            <div>

              {% for image in category.categoryImage %}
              <a href="{{ image.getUrl() }}">
                <img alt="{{ image.title }}" src="{{ image.getUrl() }}" class="rounded"  />
              </a>
      
          {% endfor %}
      
            </div>

          </div>
            </div>
          {% endif %}

            {# Fetch all entries related to this category #}
            {% set entries = craft.entries()
      .relatedTo(category)
      .orderBy('postDate DESC')
      .all() %}
<a id="page-top"></a>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-12 my-20 px-4 max-w-6xl mx-auto">

                {% for entry in entries %}
                    <article>
                        <p class="uppercase text-sm md:text-lg text-gray-500 mb-2 truncate tracking-wider ">
                            <a href="{{ entry.url }}">{{ entry.title }}</a>
                        </p>

                        {% set optimizedImages = entry.photo.one().galleryThumbnail %}
                        <a href="{{ entry.url }}">
                            <picture>
                                <source data-srcset="{{ optimizedImages.srcsetWebP() }}" data-sizes="100vw" type="image/webp"/>

                                <img class="lazyload w-full h-auto hover:opacity-90 duration-300 rounded-sm " src="{{ optimizedImages.placeholderImage() }}" data-srcset="{{ optimizedImages.srcset() }}" data-sizes="100vw" alt="Image of artwork" />

                            </picture>

                        </a>

                        <div class="flex justify-between mt-2 px-1 gap-4">

                            {% if entry.year | length %}
                                <p class="text-gray-600 uppercase text-sm">{{ entry.year }}</p>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}

            </div>

        </div>

    {% endblock %}
    <script src="/js/lightbox/js/lightbox-plus-jquery.min.js"></script>
  
    {% include '_partials/_footer.twig' %}
</body>
