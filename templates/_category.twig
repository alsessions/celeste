        <h1>{{ category.title }}</h1>

    </div>
    <div class="md:pb-20 mx-auto w-full bg-white/70 min-h-screen ">
        {% block content %}

            {# Fetch all entries related to this category #}
            {% set entries = craft.entries()
  .relatedTo(category)
  .featured(true)
  .all() %}
